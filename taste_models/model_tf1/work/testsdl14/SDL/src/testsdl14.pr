/* CIF PROCESS (250, 150), (150, 75) */
/* CIF Keep Specific Geode _REQSERVER_ 'https://gitlab.esa.int/taste/demo' */
process Testsdl14;
    /* CIF Keep Specific Geode Partition 'default' */
    /* CIF TEXT (675, 0), (267, 140) */
    -- Text area for declarations and comments
    
    timer mytime;
    dcl counter Counter;
    /* CIF ENDTEXT */
    /* CIF START (418, 29), (70, 35) */
    START;
        /* CIF task (406, 84), (92, 35) */
        task counter := 0;
        /* CIF label (418, 139), (70, 35) */
        rerun:
        /* CIF PROCEDURECALL (367, 194), (171, 35) */
        call set_timer(5000, mytime);
        /* CIF task (377, 244), (151, 35) */
        task counter := counter + 1;
        /* CIF decision (404, 299), (96, 50) */
        decision counter > 20;
            /* CIF ANSWER (374, 369), (70, 23) */
            (false):
                /* CIF join (391, 412), (35, 35) */
                join rerun;
            /* CIF ANSWER (463, 369), (70, 23) */
            (true):
        enddecision;
        /* CIF NEXTSTATE (418, 502), (70, 35) */
        NEXTSTATE Wait;
    /* CIF state (576, 75), (70, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    state Wait;
    endstate;
endprocess Testsdl14;