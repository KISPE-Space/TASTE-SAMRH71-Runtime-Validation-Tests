# This file is generated for SamRH71 RTEMS partition
#  node_1 p1  PLATFORM_SAMRH71_RTEMS ocarina_processors_arm::samrh71.rtems

.PHONY: all clean partitions partition_partition_1 partition_debug_partition_1 runtime_partition_1


all:    debug

release: partition_partition_1

debug: partition_debug_partition_1

partition_partition_1: runtime_partition_1
	# Install additional libraries
	mkdir -p "partition_1/libs"
	for dir in $(subst :, ,$(PARTITION_1_EXTERNAL_LIBS)); do \
		cp -r $$dir/* partition_1/libs/; \
	done; \
	PARTITION_1_LIB_DIRS="partition_1/libs"; \
	for d in partition_1/libs/*/; do \
    	[ -d "$$d" ] && PARTITION_1_LIB_DIRS="$$PARTITION_1_LIB_DIRS:$$d"; \
	done; \
	export PARTITION_1_EXTERNAL_SOURCE_PATH="$$PARTITION_1_LIB_DIRS:$$PARTITION_1_EXTERNAL_SOURCE_PATH"; \
	PARTITION_1_EXTERNAL_LIBS_INCLUDES=""; \
	for d in partition_1/libs partition_1/libs/*; do \
		if [ -d "$$d" ]; then \
			PARTITION_1_EXTERNAL_LIBS_INCLUDES="$$PARTITION_1_EXTERNAL_LIBS_INCLUDES -I$$d"; \
		fi; \
	done; \
	PARTITION_1_EXTERNAL_LIBS_INCLUDES="$${PARTITION_1_EXTERNAL_LIBS_INCLUDES# }"; \
	export PARTITION_1_EXTERNAL_LIBS_INCLUDES; \
	gprconfig --batch --config=Ada,,default,,GNAT --config=C,,default,,GCC --config=C++,,default,,G++; \
	gprbuild -R -p -P partition_1.gpr -XCFG="Release" -cargs:C -DSTATIC=""

partition_debug_partition_1: runtime_partition_1
	# Install additional libraries
	mkdir -p "partition_1/libs"
	for dir in $(subst :, ,$(PARTITION_1_EXTERNAL_LIBS)); do \
		cp -r $$dir/* partition_1/libs/; \
	done; \
	PARTITION_1_LIB_DIRS="partition_1/libs"; \
	for d in partition_1/libs/*/; do \
    	[ -d "$$d" ] && PARTITION_1_LIB_DIRS="$$PARTITION_1_LIB_DIRS:$$d"; \
	done; \
	export PARTITION_1_EXTERNAL_SOURCE_PATH="$$PARTITION_1_LIB_DIRS:$$PARTITION_1_EXTERNAL_SOURCE_PATH"; \
	PARTITION_1_EXTERNAL_LIBS_INCLUDES=""; \
	for d in partition_1/libs partition_1/libs/*; do \
		if [ -d "$$d" ]; then \
			PARTITION_1_EXTERNAL_LIBS_INCLUDES="$$PARTITION_1_EXTERNAL_LIBS_INCLUDES -I$$d"; \
		fi; \
	done; \
	PARTITION_1_EXTERNAL_LIBS_INCLUDES="$${PARTITION_1_EXTERNAL_LIBS_INCLUDES# }"; \
	export PARTITION_1_EXTERNAL_LIBS_INCLUDES; \
	gprconfig --batch --config=Ada,,default,,GNAT --config=C,,default,,GCC --config=C++,,default,,G++; \
	gprbuild -R -p -P partition_1.gpr -XCFG="Debug" -cargs:C -DSTATIC=""

clean:
	gprclean -P partition_1.gpr

runtime_partition_1:
	sh ./runtime_partition_1.sh

