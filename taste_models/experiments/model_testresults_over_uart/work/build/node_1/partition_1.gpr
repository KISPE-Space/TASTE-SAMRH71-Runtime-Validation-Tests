         "-Wl,-T" & SAMRH71_Linker_Script,
         "-Wl,-L/opt/taste-rtems-qdp-arm/arm-rtems6/n7sbsp-samrh71f20/lib",
         "-qrtems",
         "-Wl,--start-group",
         "-lrtemscpu",
         "-lrtemsbsp",
         "-lgcc",
         "-Wl,--end-group",
         "-Wl,-Map=output.map",
         "-Wl,--gc-sections"
         );

   package Compiler is
      for Driver ("C") use "arm-rtems6-gcc";
      for Driver ("Ada") use "arm-rtems6-gcc";
      for Driver ("C++") use "arm-rtems6-g++";

      for Required_Switches ("C") use ("-c");
      for Required_Switches ("C++") use ("-c");
      for Required_Switches ("Ada") use ("-c");

      case Build is
         when "Release" =>
            for Default_Switches ("C") use
               ("-g",
                "-O2")
                & Warning_Switches
                & SAMRH71_Switches
                & SAMRH71_CC_Switches
                & SAMRH71_Includes
                & external_as_list("PARTITION_1_USER_CFLAGS", " ")
                & external_as_list("USER_CFLAGS", " ")
                & external_as_list("PARTITION_1_EXTERNAL_LIBS_INCLUDES", " ");
            for Default_Switches ("C++") use
               ("-g",
                "-O2")
                & Warning_Switches
                & SAMRH71_Switches
                & SAMRH71_CC_Switches
                & SAMRH71_CXX_Switches
                & SAMRH71_Includes
                & external_as_list("PARTITION_1_USER_CFLAGS", " ")
                & external_as_list("USER_CFLAGS", " ")
                & external_as_list("PARTITION_1_EXTERNAL_LIBS_INCLUDES", " ");
            for Default_Switches ("Ada") use
               ("-Wall",
                "-Wextra",
                "-gnat2012",
                "-gnatwa",
                "-gnatQ")
                & SAMRH71_Switches
                & SAMRH71_Includes;
         when "Debug" =>
            for Default_Switches ("C") use
               ("-O0",
                "-g")
                & Warning_Switches
                & SAMRH71_Switches
                & SAMRH71_CC_Switches
                & SAMRH71_Includes
                & external_as_list("PARTITION_1_USER_CFLAGS", " ")
                & external_as_list("USER_CFLAGS", " ")
                & external_as_list("PARTITION_1_EXTERNAL_LIBS_INCLUDES", " ");
            for Default_Switches ("C++") use
               ("-O0",
                "-g")
                & Warning_Switches
                & SAMRH71_Switches
                & SAMRH71_CC_Switches
                & SAMRH71_CXX_Switches
                & SAMRH71_Includes
                & external_as_list("PARTITION_1_USER_CFLAGS", " ")
                & external_as_list("USER_CFLAGS", " ")
                & external_as_list("PARTITION_1_EXTERNAL_LIBS_INCLUDES", " ");
            for Default_Switches ("Ada") use
               ("-Wall",
                "-Wextra",
                "-O0",
                "-g",
                "-gnat2012",
                "-gnatwa",
                "-gnatQ")
                & SAMRH71_Switches
                & SAMRH71_Includes;
      end case;
   end Compiler;

   package Linker is
      for Driver use "arm-rtems6-gcc";

      Common_LD_Switches :=
          external_as_list("PARTITION_1_USER_LDFLAGS", " ")
          & external_as_list("USER_LDFLAGS", " ");

      case Build is
          when "Release" =>
            for Default_Switches ("C") use
                Common_LD_Switches
                & SAMRH71_LD_Switches
