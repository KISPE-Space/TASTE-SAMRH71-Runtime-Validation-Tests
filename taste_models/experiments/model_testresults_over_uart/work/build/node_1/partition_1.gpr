   package Naming is
       for Body_Suffix ("C++") use ".cc";
       for Body_Suffix ("Ada") use ".adb";
   end Naming;

   for Main use ("main.c");

   Warning_Switches :=
       ("-Wall",
        "-Wextra",
        "-Wno-unused-parameter");

   SAMRH71_Switches :=
        ("-mcpu=cortex-m7",
         "-mfloat-abi=hard",
         "-mfpu=fpv5-d16",
         "-mlittle-endian",
         "-fstack-usage",
         "-fcallgraph-info=su",
         "-mthumb",
         "-ffunction-sections",
