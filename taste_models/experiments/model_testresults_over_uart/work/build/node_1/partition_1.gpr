       "partition_1/runtime/SAMX-RTEMS-Runtime/arm-bsp/src/Uart",
       "partition_1")
       & external_as_list("EXTERNAL_SOURCE_PATH", ":")
       & external_as_list("PARTITION_1_EXTERNAL_SOURCE_PATH", ":");

   for Object_Dir use "partition_1_obj";
   for Exec_Dir   use "../../binaries";

   for Languages use (
