   SAMRH71_Includes := ("-I/opt/taste-rtems-qdp-arm/arm-rtems6/n7sbsp-samrh71f20/lib/include");

   SAMRH71_CC_Switches :=
         ("-ffunction-sections",
         "-fdata-sections",
         "-fstack-usage",
         "-fcallgraph-info=su",
         "-DRTEMS6_TARGET");

   SAMRH71_CXX_SWITCHES := ("-std=c++17");

   Home_Path := external ("HOME", "home/taste");
   SAMRH71_Default_Linker_Script := Home_Path &"/tool-inst/include/TASTE-SAMX-RTEMS-Runtime/linker_script/samrh71f20/linkcmds.intsram";
