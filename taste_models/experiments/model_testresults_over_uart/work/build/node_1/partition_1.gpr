         when "Debug" =>
            for Default_Switches ("C") use
                Common_LD_Switches
                & SAMRH71_LD_Switches
                & SAMRH71_Switches;
      end case;

   end Linker;

   package Builder is
      for Executable ("main.c") use "partition_1";
   end Builder;

   package Binder is
      for Default_Switches ("Ada") use ("-n", "-static");
      for Switches ("Ada") use ("-n",
                                "-static",
                                "--gnatbind_path=arm-rtems6-gnatbind");
   end Binder;

end Partition_1;
