   SAMRH71_Linker_Script := external ("PARTITION_1_USER_LDSCRIPT", SAMRH71_Default_Linker_Script);
   SAMRH71_Linker_Script_Dir := external ("PARTITION_1_USER_LDSCRIPT_DIR", SAMRH71_Default_Linker_Script_Dir);

   SAMRH71_LD_Switches :=
