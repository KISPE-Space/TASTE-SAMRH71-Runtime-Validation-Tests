/* CIF PROCESS (250, 150), (150, 75) */

process Testsdl08;
    /* CIF Keep Specific Geode Partition 'default' */
    /* CIF TEXT (996, 194), (266, 140) */
    -- Text area for declarations and comments
    dcl counter Counter;
    
    timer mytime;
    /* CIF ENDTEXT */
    /* CIF START (599, 116), (70, 35) */
    START;
        /* CIF task (587, 171), (92, 35) */
        task counter := 0;
        /* CIF label (599, 226), (70, 35) */
        rerun:
        /* CIF PROCEDURECALL (548, 281), (170, 35) */
        call set_timer(1000, mytime);
        /* CIF task (558, 331), (151, 35) */
        task counter := counter + 1;
        /* CIF decision (585, 386), (96, 50) */
        decision counter > 10;
            /* CIF ANSWER (554, 456), (70, 23) */
            (false):
                /* CIF join (571, 499), (35, 35) */
                join rerun;
            /* CIF ANSWER (644, 456), (70, 23) */
            (true):
                /* CIF NEXTSTATE (644, 499), (70, 35) */
                NEXTSTATE Wait;
        enddecision;
    /* CIF state (827, 215), (70, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    state Wait;
    endstate;
endprocess Testsdl08;